# Sip & Savor — Environment Template
# Duplicate this file to .env and configure real credentials

# Server & Runtime
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (SQLite default, or PostgreSQL for cloud)
DATABASE_URL="file:./prisma/dev.db"

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Fast2SMS OTP Gateway
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=SIPSAV

# DigiLocker 21+ Digital KYC
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
KYC_MINIMUM_LEGAL_AGE=21

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# West Bengal Directorate of Excise Config
EXCISE_HOLOGRAM_PREFIX=WB-EXC
EXCISE_COMMISSION_PERCENT=10.0
